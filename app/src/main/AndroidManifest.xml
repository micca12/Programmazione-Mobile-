<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Rete: chiamate REST verso Supabase -->
    <uses-permission android:name="android.permission.INTERNET" />

    <!-- Opzionale 2: foto allegata al task. CAMERA e' un permesso "dangerous":
         va anche richiesto a runtime (gestito nella sezione foto della UI) -->
    <uses-permission android:name="android.permission.CAMERA" />

    <application
        android:name=".CustomApplication"
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.TaskManager">

        <!-- Tutte le Activity si dichiarano qui, con nome completamente qualificato,
             anche se le classi vivono nel modulo uicompose -->
        <activity
            android:name="com.micca.taskmanager.uicompose.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.TaskManager">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

    </application>

</manifest>
